prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: axil-hyle
Description: Connector bridging Axil HTTP handling with Hyle dataset endpoints
Version: 0.1.0
Libs: -L${libdir} -laxil-hyle -laxil -lcorm -lxylem -lhyle -lhyle-source -ljson-c -laxil-auth
Cflags: -I${includedir}
